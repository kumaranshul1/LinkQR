{
  "manifest_version": 3,
  "name": "LinkQR",
  "version": "1.0.0",
  "description": "Right-click any link, highlighted text, or webpage to display an offline floating QR code for instant phone scanning.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
